{
  "name": "learn-the-ticker",
  "version": "0.1.0",
  "private": true,
  "description": "Citation-first local desktop asset research and learning for beginner and intermediate users.",
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm --workspace apps/desktop run dev",
    "build": "npm --workspace apps/desktop run build",
    "start": "npm --workspace apps/desktop run start",
    "test": "npm --workspace apps/desktop run test",
    "lint": "npm --workspace apps/desktop run lint",
    "typecheck": "npm --workspace apps/desktop run typecheck",
    "desktop": "npm --workspace apps/desktop run tauri dev",
    "desktop:build": "npm --workspace apps/desktop run tauri -- build -- --locked"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^16.0.0"
  }
}
